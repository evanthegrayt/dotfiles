#!/usr/bin/env bash

# Quick and dirty install script. Very weak validations.

set -eo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly INSTALL_PATH="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
readonly BREWFILE="$INSTALL_PATH/Brewfile"

action_count=0
installed=()
not_installed=()
brew_packages=false
dotfiles=false
dry_run=false
gems=false
homebrew=false

usage() {
    cat <<USAGE
USAGE: ${0##*/} [OPTIONS]

Options:
  -a | Install everything
  -b | Install Homebrew packages from Brewfile
  -B | Install Homebrew itself
  -d | Symlink dotfiles to \$HOME
  -g | Install ruby gems
  -t | Don't actually install; do a dry run
  -h | Display this help and exit
USAGE
}

brew_executable() {
    local brew_path

    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi

    for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        if [[ -x "$brew_path" ]]; then
            printf "%s\n" "$brew_path"
            return
        fi
    done

    return 1
}

while getopts ":aBbdtgh" opt; do
    case "$opt" in
        a)
            brew_packages=true
            homebrew=true
            dotfiles=true
            gems=true
            action_count=$(( action_count + 1 ))
            ;;
        B)
            homebrew=true
            action_count=$(( action_count + 1 ))
            ;;
        b)
            brew_packages=true
            action_count=$(( action_count + 1 ))
            ;;
        d)
            dotfiles=true
            action_count=$(( action_count + 1 ))
            ;;
        g)
            gems=true
            action_count=$(( action_count + 1 ))
            ;;
        t)
            dry_run=true
            ;;
        h)
            usage
            exit
            ;;
        \?)
            echo "Invalid option: -$OPTARG" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if (( action_count == 0 )); then
    echo "Must pass an install flag. See -h for options" >&2
    exit 1
fi

if [[ $dotfiles == true ]]; then
    if [[ $dry_run == true ]]; then
        installed_label="Would install:"
        not_installed_label="Would NOT install:"
    else
        installed_label="Installed:"
        not_installed_label="NOT Installed:"
    fi

    for file in "$INSTALL_PATH"/dotfiles/*; do
        filename="${file##*/}"
        target="$HOME/.$filename"

        if [[ $dry_run == true ]]; then
            if [[ -e "$target" || -L "$target" ]]; then
                not_installed+=("$filename")
            else
                installed+=("$filename")
            fi
            continue
        fi

        if [[ -e "$target" || -L "$target" ]]; then
            not_installed+=("$filename")
            continue
        fi

        ln -s "$file" "$target"
        installed+=("$filename")
    done

    echo '=============='
    echo "$installed_label"
    echo '--------------'
    printf "%s\n" "${installed[@]}"
    echo
    echo '=============='
    echo "$not_installed_label"
    echo '--------------'
    printf "%s\n" "${not_installed[@]}"
fi

if [[ $homebrew == true ]]; then
    if brew_path="$(brew_executable)"; then
        echo "Homebrew is already installed: $brew_path"
    else
        if [[ $dry_run == true ]]; then
            echo "Would attempt to install homebrew with the following command:"
            echo '/usr/bin/env bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
        elif ! command -v curl >/dev/null 2>&1; then
            echo "curl is required to install Homebrew" >&2
            exit 1
        else
            /usr/bin/env bash -c \
                "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        fi
    fi
fi

if [[ $brew_packages == true ]]; then
    if [[ ! -f "$BREWFILE" ]]; then
        echo "Brewfile not found: $BREWFILE" >&2
        exit 1
    fi

    if [[ $dry_run == true ]]; then
        echo "Would install Homebrew packages from $BREWFILE"
    elif ! brew_path="$(brew_executable)"; then
        echo "Homebrew is required to install packages from $BREWFILE" >&2
        echo "Install Homebrew first with: ${0##*/} -B" >&2
        exit 1
    else
        "$brew_path" bundle install --file "$BREWFILE"
    fi
fi

if [[ $gems == true ]]; then
    if [[ $dry_run != true ]] && ! command -v gem >/dev/null 2>&1; then
        echo "RubyGems is required to install gems" >&2
        exit 1
    fi

    for gem in standard spoonerize standup_md; do
        if [[ $dry_run == true ]]; then
            echo "Would install $gem"
        else
            gem install "$gem"
        fi
    done
fi
